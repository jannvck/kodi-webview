<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.webview"
       name="WebView"
       version="1.0.0"
       provider-name="jannvck">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <!--
    Registers the addon as a runnable plugin that appears in the
    Kodi Programs top-level menu entry.  Users can also add a
    shortcut to the Kodi home screen (Favourites) with the label
    of their choice via the addon settings.
  -->
  <extension point="xbmc.python.pluginsource"
             library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Launch a configurable website from Kodi</summary>
    <description lang="en_GB">A Kodi launcher addon that opens a user-configured website in the system browser. The website URL and the menu entry label are both configurable through the addon settings.</description>
    <news>Initial release.</news>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
